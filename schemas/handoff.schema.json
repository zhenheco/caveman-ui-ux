{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caveman-ui-ux/schemas/handoff.schema.json",
  "title": "Caveman → AutoFlow handoff contract",
  "description": "One immutable handoff item per actionable finding, plus per-key receipt.",
  "type": "object",
  "required": ["schema_version", "tool", "run_id", "items", "item_count"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "caveman-ui-ux" },
        "version": { "type": "string" }
      }
    },
    "run_id": { "type": "string", "minLength": 1 },
    "source_audit_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "repo": { "type": "string", "description": "absolute path to the repo root" },
    "cwd": { "type": "string", "description": "absolute path to the project cwd" },
    "suppressed_recursive": { "type": "boolean", "description": "true when handoff was suppressed because Caveman is running inside AutoFlow" },
    "suppressed_reason": { "type": "string" },
    "claimed_at": { "type": "string", "description": "ISO 8601 timestamp when the dispatch artifact was claimed" },
    "item_count": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/handoff_item" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" },
      "description": "non-fatal diagnostics (e.g. suppressed_recursive evidence)"
    }
  },
  "$defs": {
    "handoff_item": {
      "type": "object",
      "required": [
        "key", "run_id", "finding_id", "severity", "target",
        "fix_brief", "evidence", "source_audit_sha256", "rollback"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "description": "idempotency key: <run_id>:<finding_id>"
        },
        "run_id": { "type": "string", "minLength": 1 },
        "finding_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "severity": {
          "type": "string",
          "enum": ["blocker", "critical", "major"]
        },
        "target": {
          "type": "object",
          "required": ["route", "locale"],
          "additionalProperties": false,
          "properties": {
            "route": { "type": "string" },
            "normalized_route": { "type": "string" },
            "locale": { "type": "string" },
            "viewport": { "type": ["string", "null"] },
            "screen_id": { "type": ["string", "null"] },
            "url": { "type": ["string", "null"] }
          }
        },
        "fix_brief": {
          "type": "object",
          "required": ["intent", "acceptance", "suggested_change", "rule_ids"],
          "additionalProperties": false,
          "properties": {
            "intent": { "type": "string", "minLength": 1 },
            "acceptance": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "suggested_change": { "type": "string", "minLength": 1 },
            "rule_ids": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "target": {
              "type": "object",
              "required": ["route", "locale"],
              "additionalProperties": false,
              "properties": {
                "route": { "type": "string" },
                "normalized_route": { "type": "string" },
                "locale": { "type": "string" },
                "viewport": { "type": ["string", "null"] },
                "screen_id": { "type": ["string", "null"] },
                "url": { "type": ["string", "null"] }
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string" }
            }
          },
          "minItems": 1
        },
        "source_audit_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rollback": {
          "type": "object",
          "required": ["description", "pre_fix_head_ref"],
          "additionalProperties": false,
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "pre_fix_head_ref": { "type": "string", "minLength": 1 },
            "pre_fix_head_sha": { "type": ["string", "null"], "minLength": 1 },
            "git_root": { "type": ["string", "null"] },
            "dirty_worktree": { "type": "boolean" },
            "dirty_files": {
              "type": "array",
              "items": { "type": "string" }
            },
            "preserve_paths": {
              "type": "array",
              "items": { "type": "string" },
              "description": "workflow state paths to preserve across rollback"
            }
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["type", "message"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["suppressed_recursive", "incomplete_fix_brief", "no_evidence"] },
        "message": { "type": "string", "minLength": 1 },
        "finding_id": { "type": "string" },
        "rule_id": { "type": "string" }
      }
    }
  }
}